{
  "name": "legacy_kelmarsh_to_penmanshiel",
  "output_dir": "artifacts",
  "data": [
    {
      "adapter": "legacy_scada",
      "path": "data/all_scada.parquet",
      "dataset_id": "ore_uk",
      "sample_minutes": 10,
      "rated_power_kw": {
        "Kelmarsh": 2050.0,
        "Penmanshiel": 2050.0
      }
    }
  ],
  "train_farms": ["Kelmarsh"],
  "test_farms": ["Penmanshiel"],
  "window": {
    "lookback": 96,
    "horizons": [1, 3, 6, 12, 24],
    "stride": 6,
    "features": [
      "power_pu",
      "wind_speed_ms",
      "wind_speed_sq",
      "wind_speed_cu",
      "wind_dir_sin",
      "wind_dir_cos",
      "hour_sin",
      "hour_cos",
      "year_sin",
      "year_cos",
      "turbulence_intensity",
      "temp_delta_c",
      "rotor_speed_rpm"
    ]
  },
  "model": {
    "patch_length": 16,
    "patch_stride": 8,
    "d_model": 128,
    "n_heads": 8,
    "n_layers": 3,
    "dropout": 0.1,
    "sensor_dropout": 0.3
  },
  "training": {
    "epochs": 20,
    "batch_size": 256,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "num_workers": 0,
    "val_fraction": 0.2,
    "seed": 42,
    "balance_domains": true
  }
}
